{
  "name": "recovery-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts",
    "simulate": "tsx scripts/simulate.ts",
    "show": "tsx scripts/show-conversation.ts",
    "eval": "tsx scripts/eval.ts",
    "picker": "tsx scripts/picker.ts",
    "eval:replay": "tsx scripts/eval.ts --provider replay --gate",
    "fixtures:v2:check": "tsx scripts/check-v2-fixtures.ts",
    "worker:v2:mock": "tsx scripts/v2-mock-worker.ts",
    "workflow:v2:mock": "tsx scripts/v2-mock-workflow.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:import": "tsx scripts/import.ts"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.11",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "openai": "7.34.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
