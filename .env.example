# Local import/migration credential; never deployed
DATABASE_URL=
# Dedicated throwaway DB; only npm run test:db uses this
TEST_DATABASE_URL=
# Public application read-only credential
DATABASE_URL_READONLY=
APP_MODE=local
# Try page agent: mock (default, no AI calls) or live (real model, spends tokens).
# LIVE_DEMO_PROVIDER=live
LLM_PROVIDER=mock
# Required only for live runs; select before first paid call
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
RECORD=false
RECORDING_SET=
MAX_ESTIMATED_TOKENS_PER_RUN=100000
# V2 mock worker reads these from the process environment only; no owner fallback.
# V2_WORKER_DATABASE_URL=  (dedicated worker login; migrations must already be applied)
# V2_WORKER_ID=mock-worker-local
# Public Try page (host settings only, e.g. Vercel; off unless all are set with APP_MODE=public).
# PUBLIC_TRY=live
# TRY_OPENAI_API_KEY=      (a separate OpenAI project with a small hard spend limit)
# TRY_OPENAI_MODEL=
# DATABASE_URL_LESSONS=    (lessons-only login, db/ops/try_writer_role.sql)
# TRY_DAILY_TOKENS=500000
